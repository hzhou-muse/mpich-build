#---- modules: components, variants and build recipes -------------
# Each recipe runs in the component's build directory; $extra holds the
# variant's options for that component. run() logs and dies on failure.

macros:
    module_components: libtool, hwloc, yaksa, libfabric, ucx, mydef_boot, mpl, mpi_h, pmi, romio
    module_submodules: hwloc, libfabric, ucx, mydef_boot
    yaksa_dir: src/mpi/datatype/typerep/yaksa
    # inputs of the mpi_h module: what mpi.h, mpi_proto.h, mpir_ext.h and
    # mpi_fortran.h are generated from
    mpi_h_inputs: maint/version.m4 maint/gen_binding_c.py maint/local_python src/binding/c 'src/binding/*.txt' src/binding/abi/mpi_abi.h src/binding/fortran/mpif_h/mpi_fortran.h.in src/include/mpi.h.in src/include/mpir_ext.h.in src/include/mpix.h src/include/mpi_legacy.h src/include/nopackage.h

# -- variants: per-component configure options --------------------
subcode: set_variant
    $global %comp_opts
    $if $opts{name} eq "cpu"
        NOOP
    $elif $opts{name} eq "gpu"
        $if !$cuda_prefix
            die "variant gpu: CUDA not found (no nvcc on PATH, no /usr/local/cuda)\n"
        # pmi and romio compile against mpl's GPU headers (cuda.h)
        $(for:yaksa,libfabric,ucx,mpl,pmi,romio)
            $comp_opts{$1} = "--with-cuda=$cuda_prefix"
    $elif $opts{name} eq "hip"
        $if !$rocm_prefix
            die "variant hip: ROCm not found (no /opt/rocm or /usr/local/rocm)\n"
        $comp_opts{yaksa} = "--with-hip=$rocm_prefix"
        $comp_opts{libfabric} = "--with-rocr=$rocm_prefix"
        $comp_opts{ucx} = "--with-rocm=$rocm_prefix"
        $(for:mpl,pmi,romio)
            $comp_opts{$1} = "--with-hip=$rocm_prefix"
    $else
        die "unknown variant $opts{name} (cpu, gpu, hip)\n"

subcode: detect_host
    $global $cuda_prefix, $rocm_prefix
    my $nvcc = `which nvcc 2>/dev/null`
    chomp $nvcc
    $if $nvcc=~/^(.*)\/bin\/nvcc$/
        $cuda_prefix = $1
    $elif -d "/usr/local/cuda"
        $cuda_prefix = "/usr/local/cuda"
    $foreach $d in "/opt/rocm", "/usr/local/rocm"
        $if !$rocm_prefix and -d $d
            $rocm_prefix = $d

# -- recipes -------------------------------------------------------
subcode: recipe_libtool
    &call open_w, configure.ac
        print Out "AC_INIT\nLT_INIT\nAC_PROG_CXX\nAC_PROG_F77\nAC_PROG_FC\nLT_OUTPUT\n"
    run("libtoolize -i")
    run("aclocal")
    run("autoconf")
    run("./configure --disable-static")

# no autogen and configure (see config_hwloc.def); only the autoheader template
# of the private config header is made with autotools
subcode: recipe_hwloc
    run("mkdir -p mymake && rm -f libtool && ln -s ../libtool/libtool libtool")
    run("aclocal -I config && autoheader")
    run("rm -rf autom4te.cache aclocal.m4")
    my $args = "--enable-embedded-mode --enable-visibility=no --disable-libxml2 --disable-nvml --disable-cuda --disable-opencl --disable-rsmi CFLAGS=-fvisibility=hidden"
    mymake_inputs(".", "hwloc", {srcdir => ".", config_in => "include/private/autogen/config.h.in"}, "$args $extra")
    run("perl $mymake_dir/mymake_config.pl hwloc")
    run("perl $mymake_dir/mymake_makefile.pl hwloc")
    run("make -C hwloc -j$opts{jobs}")

# no autogen and configure (see config_yaksa.def)
subcode: recipe_yaksa
    $call yaksa_quick_setup, $extra
    $call yaksa_genpup, $extra
    $call yaksa_quick_config
    run("make -j$opts{jobs}")

# shared with checkout rebuilds (rebuild_yaksa)
subcode: yaksa_autogen
    run("sh autogen.sh --pup-max-nesting=2")

subcode: yaksa_configure(extra)
    run("./configure --enable-embedded --enable-debug $(extra)")

# the pup sources of the backends the options select (autogen.sh does all)
subcode: yaksa_genpup(options)
    $foreach $b in yaksa_backends("$(options)")
        run("./src/backend/$b/genpup.py --pup-max-nesting=2")

# seq, plus the GPU backend the options ask for
fncode: yaksa_backends($options)
    my @b = ("seq")
    $foreach $g in qw(cuda ze hip)
        $if $options=~/--with-$g\b/
            push @b, $g
    return @b

# a yaksa tree configured by mymake has mymake/opts
subcode: yaksa_quick_setup(options)
    run("mkdir -p mymake && cp maint/version.m4 mymake/")
    run("rm -f libtool && ln -s ../libtool/libtool libtool")
    mymake_inputs(".", "yaksa", {srcdir => "."}, "--enable-embedded --enable-debug $(options)")

subcode: yaksa_quick_config
    run("perl $mymake_dir/mymake_config.pl yaksa")
    run("perl $mymake_dir/mymake_makefile.pl yaksa")

subcode: recipe_libfabric
    run("sh autogen.sh")
    run("./configure --enable-embedded --enable-debug $extra")
    run("make -j$opts{jobs}")
    run("find . -name '*.la' | xargs sed -i 's, -pthread,,g'")

subcode: recipe_ucx
    # drop the UCG part of Makefile.am, from "if HAVE_UCG" to "EXTRA_DIST +="
    $call get_file_lines, Makefile.am
    my $skip
    &call open_w, Makefile.am
        $foreach $l in @lines
            $if $l=~/^if HAVE_UCG/
                $skip = 1
            $elif $l=~/^EXTRA_DIST \+=/
                $skip = 0
            $if !$skip
                print Out $l
    run("sh autogen.sh")
    run("./configure --prefix=/MODPREFIX --disable-static --disable-numa $extra")
    run("make -j$opts{jobs}")
    # mymake replaces MODDIR with the unpacked location
    my $dir = getcwd()
    run("find . -name '*.la' | xargs sed -i 's,$dir,MODDIR,g'")
    run("touch need_sed")

subcode: recipe_mydef_boot
    NOOP

# -- in-tree components, built in quick mode ------------------------
# mpl, pmi and romio each build in their own directory, which holds the
# component's files as in the MPICH tree (src/mpl, src/pmi, src/mpi/romio)
# plus mymake/ with the inputs of mymake_config.pl / mymake_makefile.pl;
# dependencies are found as siblings (../mpl, ../mpi_h/include).
subcode: recipe_mpl
    comp_setup($dir, $c)
    run("perl $mymake_dir/mymake_config.pl mpl")
    run("perl $mymake_dir/mymake_makefile.pl mpl")
    run("make -j$opts{jobs}")

subcode: recipe_pmi
    comp_setup($dir, $c)
    run("python3 maint/gen_pmi_msg.py")
    run("perl $mymake_dir/mymake_config.pl pmi")
    run("perl $mymake_dir/mymake_makefile.pl pmi")
    run("make -j$opts{jobs}")

subcode: recipe_romio
    comp_setup($dir, $c)
    run("perl $mymake_dir/mymake_config.pl romio")
    run("perl $mymake_dir/mymake_makefile.pl romio")
    run("make -j$opts{jobs}")

# the module is just include/ with the generated and copied headers
subcode: recipe_mpi_h
    my $work = "$dir/work"
    mkdir $work or die "mkdir $work: $!\n"
    chdir $work
    frame_setup($work, $c)
    run("mkdir -p src/mpi_t test/mpi/include")
    run("python3 maint/gen_binding_c.py -single-source")
    run("perl $mymake_dir/mymake_config.pl mpi_h")
    mkdir "$dir/include" or die "mkdir $dir/include: $!\n"
    $foreach $h in qw(src/include/mpi.h src/include/mpi_proto.h src/include/mpix.h src/include/mpi_legacy.h src/include/mpir_ext.h src/include/nopackage.h src/binding/fortran/mpif_h/mpi_fortran.h src/binding/abi/mpi_abi.h)
        run("cp $h $dir/include/")
    chdir $dir
    run("rm -rf $work")

# -- helpers -------------------------------------------------------
fncode: run($cmd)
    $global $run_log
    &call open_a, $run_log
        print Out "\n: $cmd\n"
    system("($cmd) >> $run_log 2>&1") == 0 or die "failed: $cmd\n"

subcode: open_a(file)
    open Out, ">>$(file)" or die "Can't append $(file): $!\n"
    BLOCK
    close Out

# -- which variant a build wants, and where its tarball is ----------
fncode: modules_variant
    $if $opts{"with-cuda"}
        return "gpu"
    $elif $opts{"with-hip"}
        return "hip"
    return "cpu"

# MODTARBALL, else modules.tar.gz in the checkout, else
# ../mpich-modules/modules-<variant>.tar.gz. A given tarball named
# modules[-<name>].tar.gz is swapped for modules-<variant>.tar.gz next to it
# when that exists.
fncode: find_mod_tarball
    my $variant = modules_variant()
    my $given = $ENV{MODTARBALL}
    $if !$given and -e "modules.tar.gz"
        $given = "modules.tar.gz"
    my @cands
    $if $given
        $if $given=~/^(.*\/)?modules(-\w+)?\.tar\.gz$/
            my $dir = $1
            push @cands, "${dir}modules-$variant.tar.gz"
            $if $variant eq "cpu"
                push @cands, "${dir}modules.tar.gz"
        push @cands, $given
    $else
        my $parent = $pwd
        $parent =~ s/\/[^\/]+$//
        push @cands, "$parent/mpich-modules/modules-$variant.tar.gz"
    $foreach $t in @cands
        $if -e $t
            return $t
    die "no modules tarball (looked for @cands): set MODTARBALL, or MODDIR to an unpacked one, or build one with mymake_modules.pl --name=$variant\n"

# -- STAMP -----------------------------------------------------------
fncode: read_stamp($file)
    $if !-f $file
        return undef
    my %h
    &call open_r, $file
        $if /^(\S+): ?(.*)/
            $h{$1} = $2
    return \%h

fncode: write_stamp($file, $h)
    &call open_w, $file
        $foreach $k in sort keys %$h
            print Out "$k: $h->{$k}\n"

# hash of $dir in $repo as in the working tree, so uncommitted edits count;
# ignored (generated) files don't
fncode: tree_hash($repo, $dir, $tmpdir)
    my $idx = "$tmpdir/.index-$$"
    unlink $idx
    my $t = `GIT_INDEX_FILE=$idx git -C $repo add -A -- $dir && GIT_INDEX_FILE=$idx git -C $repo write-tree --prefix=$dir/`
    unlink $idx
    chomp $t
    $if $t!~/^[0-9a-f]+$/
        die "can't hash $repo/$dir\n"
    return $t

# same, for a set of paths (pathspecs) in $repo, as one tree
fncode: tree_hash_paths($repo, $paths, $tmpdir)
    my $idx = "$tmpdir/.index-$$"
    unlink $idx
    my $t = `GIT_INDEX_FILE=$idx git -C $repo add -A -- $paths && GIT_INDEX_FILE=$idx git -C $repo write-tree`
    unlink $idx
    chomp $t
    $if $t!~/^[0-9a-f]+$/
        die "can't hash $paths in $repo\n"
    return $t

# keys of the quick-mode components, from $repo's working tree; pmi and
# romio include the keys of the modules they compile against
fncode: quick_keys($repo, $tmpdir, $mpl_opts)
    my %k
    $k{mpl} = tree_hash($repo, "src/mpl", $tmpdir)
    $k{mpi_h} = tree_hash_paths($repo, "$(mpi_h_inputs)", $tmpdir)
    my $mpl = "mpl:$k{mpl}/$mpl_opts"
    $k{pmi} = tree_hash($repo, "src/pmi", $tmpdir) . " $mpl"
    $k{romio} = tree_hash($repo, "src/mpi/romio", $tmpdir) . " $mpl mpi_h:$k{mpi_h}"
    # the module layout (flat: <component>/ is the component's directory)
    $foreach $c in qw(mpl pmi romio)
        $k{$c} .= " layout:flat"
    return \%k

# (re)build a quick-mode component from scratch in $dir; takes seconds
fncode: build_quick($c, $dir)
    system "rm -rf $dir"
    mkdir $dir or die "mkdir $dir: $!\n"
    chdir $dir or die "chdir $dir: $!\n"
    $(for:a in mpl, mpi_h, pmi, romio)
        $case $c eq "$(a)"
            $call recipe_$(a)

# -- in-tree components: follow the checkout ---------------------------
# copy the files of $repo/$dir (tracked and untracked) that differ from $dst
fncode: sync_tree($repo, $dir, $dst)
    $use File::Compare
    $use File::Copy
    $use File::Path qw(make_path)
    my @changed
    my $list = `git -C $repo ls-files -co --exclude-standard -- $dir`
    $foreach $f in split /\n/, $list
        my $rel = substr($f, length($dir) + 1)
        my ($src, $to) = ("$repo/$f", "$dst/$rel")
        $if !-e $to or compare($src, $to) != 0
            $if $to=~/^(.*)\//
                make_path($1)
            copy($src, $to) or die "copy $src: $!\n"
            chmod((stat $src)[2] & 07777, $to)
            push @changed, $rel
    return @changed

# Bring $moddir/yaksa up to date with the checkout's yaksa and rebuild it in
# full (the tarball has no objects); autogen and configure run again only
# when their inputs changed or extra options are given.
fncode: rebuild_yaksa($repo, $moddir, $options, $extra, $jobs)
    $run_log = "$moddir/yaksa-rebuild.log"
    unlink $run_log
    my @changed = sync_tree($repo, "$(yaksa_dir)", "$moddir/yaksa")
    my $n = @changed
    $print "  yaksa: $n files updated from the checkout, log in $run_log"
    my @regen = grep { /(^|\/)(configure\.ac|Makefile\.am|autogen\.sh|genpup\.py|[^\/]+\.mk|[^\/]+\.m4)$/ } @changed
    chdir "$moddir/yaksa" or die "chdir $moddir/yaksa: $!\n"
    $if -f "mymake/opts"
        # configured by mymake: regenerate, it takes seconds
        my @pup = grep { /(^|\/)(genpup\.py|gencomm\.py|yutils\.py)$/ } @changed
        $if @pup or $extra
            $call yaksa_genpup, $options $extra
        $call yaksa_quick_setup, $options $extra
        $call yaksa_quick_config
    $else
        $if @regen
            $call yaksa_autogen
        $if @regen or $extra
            $call yaksa_configure, $options $extra
    run("make clean")
    run("make -j$jobs")
    chdir $pwd

# Compare the modules tree with the checkout: warn about the variant and
# submodule commits, rebuild yaksa when it differs.
fncode: check_modules
    my $moddir = $opts{moddir}
    my $stamp = read_stamp("$moddir/modules.stamp")
    $if !$stamp
        $print "modules: no modules.stamp in $moddir (older tarball), skipping checks"
        return
    my $want = modules_variant()
    $if $stamp->{variant} ne $want
        $print "WARNING: the modules are variant $stamp->{variant}, this build wants $want ($moddir)"
    $if system("git -C $pwd rev-parse --git-dir >/dev/null 2>&1") != 0
        return
    $foreach $c in qw(hwloc libfabric ucx mydef_boot)
        my $have = $stamp->{"key-$c"}
        my $t = `git -C $pwd ls-tree HEAD modules/$c`
        $if $t=~/commit\s+([0-9a-f]+)/ and $have and $1 ne $have
            $print "WARNING: modules/$c: the modules have $have, the checkout records $1"
    my $h = tree_hash($pwd, "$(yaksa_dir)", $moddir)
    $if $stamp->{"key-yaksa"} and $h ne $stamp->{"key-yaksa"}
        $if $opts{moddir_shared}
            $print "WARNING: yaksa differs from the checkout; not rebuilding it in the shared MODDIR $moddir"
            return
        $print "modules: yaksa differs from the checkout, rebuilding it in $moddir/yaksa"
        my $jobs = `nproc`
        chomp $jobs
        my $ok = eval { rebuild_yaksa($pwd, $moddir, $stamp->{"options-yaksa"}, "", $jobs); 1 }
        $if !$ok
            print $@
            system "tail -15 $moddir/yaksa-rebuild.log"
            die "yaksa rebuild failed\n"
        $stamp->{"key-yaksa"} = $h
        write_stamp("$moddir/modules.stamp", $stamp)
    $call check_quick_modules

    # mpl, mpi_h, pmi, romio: rebuild those whose key differs (dependents
    # follow, since their keys include their dependencies' keys)
    subcode: check_quick_modules
        my $want = quick_keys($pwd, $moddir, $stamp->{"options-mpl"})
        my @rebuild = grep { $stamp->{"key-$_"} and $stamp->{"key-$_"} ne $want->{$_} } qw(mpl mpi_h pmi romio)
        $if @rebuild and $opts{moddir_shared}
            $print "WARNING: @rebuild differ from the checkout; not rebuilding them in the shared MODDIR $moddir"
        $elif @rebuild
            $print "modules: @rebuild differ from the checkout, rebuilding in $moddir"
            # the recipes' context, as in mymake_modules.pl
            local $opts{mpich} = $pwd
            local $opts{jobs} = `nproc`
            chomp $opts{jobs}
            $variant_dir = $moddir
            $foreach $c in qw(mpl mpi_h pmi romio)
                $comp_opts{$c} = $stamp->{"options-$c"}
            $foreach $c in @rebuild
                $run_log = "$moddir/$c-rebuild.log"
                unlink $run_log
                my $ok = eval { build_quick($c, "$moddir/$c"); 1 }
                chdir $pwd
                $if !$ok
                    print $@
                    system "tail -15 $run_log"
                    die "$c rebuild failed\n"
                $print "  $c: rebuilt, log in $run_log"
                $stamp->{"key-$c"} = $want->{$c}
            write_stamp("$moddir/modules.stamp", $stamp)

# -- quick-mode component trees ----------------------------------------
# a component in its own directory: its files, mymake/ (opts, args,
# make_opts.mpich, version.m4) and libtool from the sibling libtool module
fncode: comp_setup($dir, $c)
    my %paths = (mpl => "src/mpl", pmi => "src/pmi", romio => "src/mpi/romio")
    my $path = $paths{$c}
    my $n = () = $path =~ /\//g
    $n += 1
    run("git -C $opts{mpich} ls-files -z -co --exclude-standard -- $path | (cd $opts{mpich} && tar --null -T - -cf -) | tar -C $dir --strip-components=$n -xf -")
    run("mkdir -p $dir/mymake && cp $opts{mpich}/maint/version.m4 $dir/mymake/")
    run("ln -s ../libtool/libtool $dir/libtool")
    my %o = (srcdir => ".", mpl_dir => "../mpl", mpi_includedir => "../mpi_h/include", version_m4 => "mymake/version.m4")
    mymake_inputs($dir, $c, \%o)

# mpi_h: an MPICH-like work tree (maint, src/binding, src/include), as its
# generators expect
fncode: frame_setup($top, $c)
    $global $variant_dir
    run("mkdir -p $top/maint $top/mymake $top/src")
    run("cp $variant_dir/libtool/libtool $top/libtool")
    run("git -C $opts{mpich} ls-files -z -co --exclude-standard -- maint src/binding src/include | (cd $opts{mpich} && tar --null -T - -cf -) | tar -C $top -xf -")
    mymake_inputs($top, $c, {})

# mymake/{args,opts,make_opts.mpich} in $top: the variant's options for
# component $c, plus %$extra
fncode: mymake_inputs($top, $c, $extra, $args_in)
    $global %comp_opts
    my $args = defined $args_in ? $args_in : $comp_opts{$c}
    &call open_w, $top/mymake/args
        print Out "$args\n"
    my %o = (CC => $ENV{CC} || "gcc", CXX => $ENV{CXX} || "g++", FC => $ENV{FC} || "gfortran", quick => 1, %$extra)
    my $cflags = "-g -O2"
    $foreach $a in split /\s+/, $args
        $if $a=~/^--([\w-]+)=(.*)/
            $o{$1} = $2
        $elif $a=~/^--([\w-]+)$/
            $o{$1} = 1
        $elif $a=~/^CFLAGS=(.*)/
            $cflags = $1
    &call open_w, $top/mymake/opts
        $foreach $k in sort keys %o
            print Out "$k: $o{$k}\n"
    my $ver = `$o{CC} -dumpfullversion 2>/dev/null`
    chomp $ver
    &call open_w, $top/mymake/make_opts.mpich
        print Out "CC: $o{CC}\nCXX: $o{CXX}\nF77: $o{FC}\nFC: $o{FC}\n"
        print Out "cc_version: gcc $ver\ncc_weak: \ncflags: $cflags\nldflags: \n"
