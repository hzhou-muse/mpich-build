include: macros_common/mymake.def
include: macros_mymake/modules.def

output_dir: ./mymake

# Build a modules tarball for one preset variant from an MPICH checkout:
#     mymake_modules.pl --name=cpu|gpu|hip [--mpich=<checkout>] [--out=<dir>]
#                       [-j=N] [--only=hwloc,yaksa] [--force]
# or, inside a checkout whose modules are unpacked in mymake/, rebuild one
# component from the checkout's source, with extra configure options:
#     mymake_modules.pl --rebuild=yaksa [configure options]
# Components build in <out>/<name>/<component>/ and are kept; a component is
# rebuilt only when its source (commit or tree hash) or options change.

page: mymake_modules
    module: perl

    $global @components = qw(libtool hwloc yaksa libfabric ucx mydef_boot mpl mpi_h pmi romio)

    $call parse_args_modules
    $if $opts{rebuild}
        $call rebuild_in_checkout
        exit 0
    $call detect_host
    $call set_variant
    $call get_sources
    $call build_components
    $call pack_tarball

subcode: parse_args_modules
    $opts{name} = "cpu"
    $opts{mpich} = $pwd
    $opts{jobs} = `nproc`
    chomp $opts{jobs}
    $global @extra_args
    $foreach $a in @ARGV
        $if $a=~/^--?(name|mpich|out|only|rebuild)=(.*)/
            $opts{$1} = $2
        $elif $a=~/^-j=?(\d+)$/
            $opts{jobs} = $1
        $elif $a eq "--force"
            $opts{force} = 1
        $else
            push @extra_args, $a
    $if @extra_args and !$opts{rebuild}
        die "Usage: $0 --name=cpu|gpu|hip [--mpich=<checkout>] [--out=<dir>] [-j=N] [--only=a,b] [--force]\n       $0 --rebuild=yaksa [configure options]\n"
    # the rest is for building a variant
    $if !$opts{rebuild}
        $opts{mpich} = Cwd::abs_path($opts{mpich})
        $if !-f "$opts{mpich}/maint/version.m4"
            die "$opts{mpich} is not an MPICH checkout\n"
        $if !$opts{out}
            $opts{out} = $opts{mpich}
            $opts{out} =~ s/\/[^\/]+$//
            $opts{out} .= "/mpich-modules"
        system "mkdir -p $opts{out}/$opts{name} $opts{out}/src"
        $opts{out} = Cwd::abs_path($opts{out})
        $global $variant_dir
        $variant_dir = "$opts{out}/$opts{name}"
        $print variant $opts{name}: $variant_dir

# -- sources: commits recorded by the checkout -----------------------
subcode: get_sources
    $global %src_dir, %src_key
    my $mpich = $opts{mpich}
    $(for:a in $(module_submodules))
        $call get_submodule, $(a)
    $src_dir{yaksa} = "$mpich/$(yaksa_dir)"
    my $tmp = "$opts{out}/src"
    $src_key{yaksa} = tree_hash($mpich, "$(yaksa_dir)", $tmp)
    # in-tree components built in quick mode
    my $k = quick_keys($mpich, $tmp, $comp_opts{mpl})
    $foreach $c in keys %$k
        $src_key{$c} = $k->{$c}
    my $lt = `libtoolize --version | head -1`
    chomp $lt
    $src_key{libtool} = $lt

    subcode: get_submodule(c)
        my $t = `git -C $mpich ls-tree HEAD modules/$(c)`
        $if $t!~/commit\s+([0-9a-f]+)/
            die "modules/$(c) is not a submodule in $mpich\n"
        my $commit = $1
        my $url = `git -C $mpich config -f .gitmodules submodule.modules/$(c).url`
        chomp $url
        my $src = "$opts{out}/src/$(c)"
        $if !-d "$src/.git"
            # an initialized submodule in the checkout saves a download
            my $from = $url
            $if -e "$mpich/modules/$(c)/.git"
                $from = "$mpich/modules/$(c)"
            $print clone $(c) from $from
            system("git clone -q $from $src") == 0 or die "clone $(c) failed\n"
            system "git -C $src remote set-url origin $url"
        $if system("git -C $src cat-file -e $commit^{commit} 2>/dev/null") != 0
            $print fetch $(c) $commit
            system("git -C $src fetch -q origin $commit") == 0 or die "fetch $(c) $commit failed\n"
        # a "build" branch, as the old scripts made (ucx records the branch name)
        system("git -C $src checkout -q -B build $commit") == 0 or die "checkout $(c) $commit failed\n"
        $src_dir{$(c)} = $src
        $src_key{$(c)} = $commit

# -- build -----------------------------------------------------------
subcode: build_components
    my %only
    $if $opts{only}
        $foreach $c in split /,/, $opts{only}
            $only{$c} = 1
    my @todo
    $foreach $c in @components
        my $key = "source: $src_key{$c}\noptions: $comp_opts{$c}\n"
        my $stamp = "$variant_dir/$c/.mymake_built"
        my $old
        $if -f $stamp
            $old = `cat $stamp`
        $if %only and !$only{$c}
            next
        $if !$opts{force} and !%only and $old eq $key
            $print "  $c: up to date"
            next
        push @todo, $c

    # in waves: libtool (the quick-mode components copy it); then the rest;
    # then pmi and romio, which compile against mpl and mpi_h
    my %wave = (libtool => 0, pmi => 2, romio => 2)
    my @failed
    $for $w=0:3
        last if @failed
        my %pid
        $foreach $c in @todo
            $if ($wave{$c} // 1) == $w
                my $pid = fork()
                die "fork failed\n" if !defined $pid
                $if $pid == 0
                    exit(build_one($c) ? 0 : 1)
                $pid{$pid} = $c
        $while %pid
            my $pid = wait()
            last if $pid < 0
            $if $? != 0
                push @failed, $pid{$pid}
            delete $pid{$pid}
    $if @failed
        $foreach $c in @failed
            $print "== $c failed, last lines of $variant_dir/$c.log:"
            system "tail -15 $variant_dir/$c.log"
        die "build failed: @failed\n"

fncode: build_one($c)
    my $dir = "$variant_dir/$c"
    $run_log = "$variant_dir/$c.log"
    unlink $run_log
    $print "  $c: building, log in $run_log"
    my $ok = eval { build_one_body($c, $dir); 1 }
    $if !$ok
        &call open_a, $run_log
            print Out "\n$@"
        return 0
    &call open_w, $dir/.mymake_built
        print Out "source: $src_key{$c}\noptions: $comp_opts{$c}\n"
    $print "  $c: done"
    return 1

fncode: build_one_body($c, $dir)
        # start from a clean copy of the source, as the old scripts did
        system "rm -rf $dir"
        $if $c=~/^(libtool|mpl|mpi_h|pmi|romio)$/
            # (quick-mode components get their sources in comp_setup / frame_setup)
            mkdir $dir or die "mkdir $dir: $!\n"
        $elif $c eq "yaksa"
            mkdir $dir or die "mkdir $dir: $!\n"
            # tracked and untracked files, as in the working tree
            my $n = () = "$(yaksa_dir)" =~ /\//g
            $n += 1
            run("git -C $opts{mpich} ls-files -z -co --exclude-standard -- $(yaksa_dir) | (cd $opts{mpich} && tar --null -T - -cf -) | tar -C $dir --strip-components=$n -xf -")
        $else
            run("cp -a $src_dir{$c} $dir")
        chdir $dir or die "chdir $dir: $!\n"
        my $extra = $comp_opts{$c}
        $(for:a in $(module_components))
            $case $c eq "$(a)"
                $call recipe_$(a)
        chdir $opts{out}

# -- pack ------------------------------------------------------------
subcode: pack_tarball
    # like build_tarball.sh: no .git, and no *.o except for ucx; no build stamps
    my $tar = "$opts{out}/modules-$opts{name}.tar"
    unlink $tar, "$tar.gz"
    chdir $variant_dir or die "chdir $variant_dir: $!\n"
    $call write_modules_stamp
    my @others = grep { $_ ne "ucx" } @components
    push @others, "modules.stamp"
    system("tar -cf $tar --exclude=.git --exclude=.mymake_built --exclude='*.o' @others") == 0 or die "tar failed\n"
    system("tar -rf $tar --exclude=.git --exclude=.mymake_built ucx") == 0 or die "tar failed\n"
    system("gzip $tar") == 0 or die "gzip failed\n"
    chdir $pwd
    $print "--> $tar.gz"

# what the tarball was built from, for mymake's checks (check_modules)
subcode: write_modules_stamp
    my %stamp
    $stamp{variant} = $opts{name}
    $stamp{mpich} = `git -C $opts{mpich} rev-parse HEAD`
    $stamp{cc} = `\${CC:-gcc} --version | head -1`
    $stamp{fc} = `\${FC:-gfortran} --version | head -1`
    $stamp{date} = `date -Iseconds`
    $foreach $k in keys %stamp
        chomp $stamp{$k}
    $foreach $c in @components
        $stamp{"key-$c"} = $src_key{$c}
        $stamp{"options-$c"} = $comp_opts{$c}
    write_stamp("$variant_dir/modules.stamp", \%stamp)

# --rebuild=<component> inside a checkout: its own modules tree only
subcode: rebuild_in_checkout
    $if $opts{rebuild} ne "yaksa"
        die "--rebuild: only yaksa for now\n"
    $if $ENV{MODDIR}
        die "--rebuild won't change the shared MODDIR $ENV{MODDIR}; unset MODDIR to use an unpacked copy\n"
    my $moddir = "$pwd/mymake"
    my $stamp = read_stamp("$moddir/modules.stamp")
    $if !-f "$pwd/maint/version.m4" or !$stamp
        die "--rebuild: run it in an MPICH checkout whose modules are unpacked in mymake/ (run mymake.pl first)\n"
    my $extra = join(' ', @extra_args)
    my $options = $stamp->{"options-yaksa"}
    $print "rebuild yaksa in $moddir/yaksa, options: $options $extra"
    my $ok = eval { rebuild_yaksa($pwd, $moddir, $options, $extra, $opts{jobs}); 1 }
    $if !$ok
        print $@
        system "tail -15 $moddir/yaksa-rebuild.log"
        die "yaksa rebuild failed\n"
    $stamp->{"key-yaksa"} = tree_hash($pwd, "$(yaksa_dir)", $moddir)
    $stamp->{"options-yaksa"} = "$options $extra"
    $stamp->{"options-yaksa"} =~ s/^\s+|\s+$//g
    write_stamp("$moddir/modules.stamp", $stamp)
    $print "  yaksa: done; run make in the checkout to relink"
